# Opcjonalne ustawienia SONORA. Skopiuj ten plik jako .env, aby je zmienić.
# Aplikacja nie wymaga żadnych kluczy API ani sekretów.

# Wyszukiwanie w otwartym katalogu Openverse (utwory na licencjach Creative Commons).
# Ustaw "false", aby całkowicie wyłączyć zapytania do zewnętrznego serwisu.
VITE_ENABLE_OPENVERSE=true
